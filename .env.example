# Copy to .env; never commit it.
# Point DNS A/AAAA at your host and open public ports 80/443.
DOMAIN=your-domain.example
INVENTRACK_BACKUP_KEY=GENERATE_WITH_python_-m_backend.backup_generate-key
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENABLE_LIVE_PAYMENTS=NO
GEMINI_API_KEY=

# Encrypts chatbot provider secrets at rest; set for every cloud instance.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INVENTRACK_AI_KEY=

# Passwordless login (Twilio Verify; configure SendGrid email integration)
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_API_KEY=
TWILIO_VERIFY_API_SECRET=
